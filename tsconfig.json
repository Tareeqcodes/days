{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "./src",
    "outFile": "./app.js",
    "ignoreDeprecations": "6.0",
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["src/main.ts"]
}
